{
  "schema": 1,
  "id": "sill.clock",
  "name": "Clock",
  "description": "A quiet clock for the rail.",
  "version": "1.0.0",
  "author": "raoxi",
  "license": "MIT",
  "runtime": ">=0.5.4",
  "engine": ">=0.1.0",
  "type": "template",
  "size": { "w": 384, "h": 160, "minW": 240, "minH": 96 },
  "span": { "default": 1 },
  "permissions": ["data.time"],
  "data": [{ "id": "now", "source": "time.now" }],
  "strings": {
    "en": { "label": "LOCAL TIME" },
    "zh": { "label": "本地时间" }
  },
  "ui": "ui/index.html"
}
