{
  "schema": 1,
  "id": "com.example.webclock",
  "name": "Web Clock",
  "description": "Trusted web component with Node.",
  "version": "1.0.0",
  "author": "raoxi",
  "license": "MIT",
  "runtime": ">=0.5.4",
  "engine": ">=0.1.0",
  "type": "web",
  "trust": "trusted",
  "size": { "w": 384, "h": 160 },
  "span": { "default": 1 },
  "permissions": ["data.time"],
  "data": [{ "id": "now", "source": "time.now" }],
  "ui": "ui/index.html"
}
