{
  "schema": 1,
  "id": "com.example.rings",
  "name": "Rings",
  "description": "CPU / GPU / RAM / SWAP as Apple-style activity rings in one card.",
  "version": "1.2.0",
  "author": "raoxi",
  "license": "MIT",
  "runtime": ">=0.6.0",
  "engine": ">=0.1.0",
  "type": "template",
  "size": { "w": 260, "h": 252 },
  "span": { "default": 1 },
  "permissions": ["data.system"],
  "data": [
    { "id": "cpu", "source": "system.cpu" },
    { "id": "gpu", "source": "system.gpu" },
    { "id": "mem", "source": "system.memory" },
    { "id": "swap", "source": "system.swap" }
  ],
  "ui": "ui/index.html"
}

