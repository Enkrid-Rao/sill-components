{
  "schema": 1,
  "id": "sill.lyrics",
  "name": "Lyrics",
  "version": "1.1.0",
  "author": "Sill",
  "license": "MIT",
  "runtime": ">=0.6.0",
  "engine": ">=0.1.0",
  "type": "template",
  "span": { "default": 1 },
  "size": { "w": 384, "h": 180 },
  "permissions": ["data.media"],
  "data": [{ "id": "media", "source": "media.nowPlaying" }],
  "settings": [
    {
      "key": "offset",
      "type": "number",
      "label": { "en": "Lyric offset", "zh": "歌词偏移" },
      "description": {
        "en": "Seconds. Positive values show lyrics later.",
        "zh": "秒。正数表示歌词延后显示。"
      },
      "min": -10,
      "max": 10,
      "default": 0
    }
  ],
  "strings": {
    "en": {
      "title": "LYRICS",
      "synced": "Synced",
      "plain": "No timing",
      "loading": "Searching",
      "idle": "Nothing playing",
      "idleHint": "Open a music app and lyrics appear here.",
      "empty": "No lyrics found",
      "emptyHint": "This track may not be in the LRCLIB database yet.",
      "error": "Lyrics unavailable",
      "errorHint": "The lookup failed. Check the network and try again.",
      "instrumental": "Instrumental",
      "instrumentalHint": "This track has no vocals.",
      "retry": "Search again"
    },
    "zh": {
      "title": "歌词",
      "synced": "同步",
      "plain": "无时间轴",
      "loading": "搜索中",
      "idle": "没有在播放",
      "idleHint": "打开音乐应用后，歌词会显示在这里。",
      "empty": "没有找到歌词",
      "emptyHint": "这首歌可能还没有收录到 LRCLIB。",
      "error": "歌词暂时取不到",
      "errorHint": "查询失败，检查网络后再试一次。",
      "instrumental": "纯音乐",
      "instrumentalHint": "这首歌没有人声。",
      "retry": "重新搜索"
    }
  },
  "ui": "ui/index.html"
}
