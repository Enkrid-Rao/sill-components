{
  "schema": 1,
  "id": "sill.rings",
  "name": "Rings",
  "description": "CPU / GPU / RAM / SWAP as four rings, with used / total under each.",
  "version": "1.1.1",
  "author": "Sill",
  "license": "MIT",
  "runtime": ">=0.7.0",
  "engine": ">=0.1.0",
  "type": "template",
  "size": {
    "w": 260,
    "h": 252
  },
  "span": {
    "default": 2
  },
  "permissions": [
    "data.system"
  ],
  "data": [
    {
      "id": "cpu",
      "source": "system.cpu"
    },
    {
      "id": "gpu",
      "source": "system.gpu"
    },
    {
      "id": "mem",
      "source": "system.memory"
    },
    {
      "id": "swap",
      "source": "system.swap"
    }
  ],
  "strings": {
    "en": {
      "noData": "No data"
    },
    "zh": {
      "noData": "无数据"
    }
  },
  "ui": "ui/index.html"
}
