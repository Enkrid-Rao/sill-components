{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sill.local/schemas/widget.schema.json",
  "title": "Sill component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "author",
    "license",
    "runtime",
    "type",
    "permissions",
    "ui"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "minLength": 3,
      "maxLength": 80,
      "description": "Reverse-domain identifier, globally unique."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "description": { "type": "string", "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "homepage": { "type": "string", "format": "uri" },
    "runtime": { "type": "string", "minLength": 1, "maxLength": 80 },
    "type": { "enum": ["declarative", "script"] },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 240, "maximum": 1180 },
        "h": { "type": "integer", "minimum": 64, "maximum": 1200 },
        "minW": { "type": "integer", "minimum": 240, "maximum": 1180 },
        "minH": { "type": "integer", "minimum": 64, "maximum": 1200 }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "data.time",
          "data.system",
          "data.media",
          "data.weather",
          "data.todo",
          "data.files",
          "storage",
          "network",
          "commands",
          "settings"
        ]
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "source": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "ui": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:).+$",
      "description": "Relative path inside the package."
    },
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type", "default"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "const": "boolean" },
              "default": { "type": "boolean" },
              "label": { "$ref": "#/$defs/localizedLabel" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type", "default"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "const": "number" },
              "default": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "label": { "$ref": "#/$defs/localizedLabel" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type", "default", "options"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "const": "select" },
              "default": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label"],
                  "properties": {
                    "value": { "type": "string" },
                    "label": { "$ref": "#/$defs/localizedLabel" }
                  }
                }
              },
              "label": { "$ref": "#/$defs/localizedLabel" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type", "default"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "const": "string" },
              "default": { "type": "string" },
              "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
              "label": { "$ref": "#/$defs/localizedLabel" }
            }
          }
        ]
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:).+$" }
    }
  },
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "maxLength": 80 },
        "zh": { "type": "string", "maxLength": 80 }
      },
      "minProperties": 1
    }
  }
}
