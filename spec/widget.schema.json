{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sill.local/schemas/widget.schema.json",
  "title": "Sill widget manifest",
  "description": "widget.json — the only entry point of a Sill template widget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "author",
    "license",
    "runtime",
    "engine",
    "type",
    "permissions",
    "ui"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "minLength": 3,
      "maxLength": 80
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "description": { "type": "string", "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "homepage": { "type": "string", "format": "uri" },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Host application range."
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Template engine range."
    },
    "type": { "const": "template" },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 160, "maximum": 1180 },
        "h": { "type": "integer", "minimum": 48, "maximum": 2200 },
        "minW": { "type": "integer", "minimum": 160, "maximum": 1110 },
        "minH": { "type": "integer", "minimum": 48, "maximum": 2200 }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "type": "integer", "minimum": 1, "maximum": 3 },
        "byColumns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": { "type": "integer", "minimum": 1, "maximum": 1 },
            "2": { "type": "integer", "minimum": 1, "maximum": 2 },
            "3": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["data.time", "data.system", "data.media", "data.weather", "data.todo"]
      }
    },
    "data": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$" },
          "source": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
          "description": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "ui": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:).+\\.html$",
      "maxLength": 200,
      "description": "Relative path to the HTML template, normally ui/index.html."
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:).+$",
      "maxLength": 200
    }
  }
}
