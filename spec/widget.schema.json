{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sill.local/schemas/widget.schema.json",
  "title": "Sill widget manifest",
  "description": "widget.json — the only entry point of a Sill template widget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "type",
    "ui"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Host application range."
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Template engine range."
    },
    "type": {
      "enum": [
        "template",
        "web"
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 160,
          "maximum": 1180
        },
        "h": {
          "type": "integer",
          "minimum": 48,
          "maximum": 2200
        },
        "minW": {
          "type": "integer",
          "minimum": 160,
          "maximum": 1110
        },
        "minH": {
          "type": "integer",
          "minimum": 48,
          "maximum": 2200
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "byColumns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "2": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "3": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "description": "Metadata for the install prompt; not enforced at runtime."
    },
    "data": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:\\.[a-zA-Z][a-zA-Z0-9]*)+$"
          },
          "description": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/strings"
        },
        "zh": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 16,
      "description": "Declared component settings; the host renders the form and stores values in widget-settings/<id>.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
          },
          "type": {
            "enum": [
              "text",
              "number",
              "switch",
              "select"
            ]
          },
          "label": {
            "$ref": "#/$defs/settingText"
          },
          "description": {
            "$ref": "#/$defs/settingText"
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "placeholder": {
            "type": "string",
            "maxLength": 80
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "label": {
                  "$ref": "#/$defs/settingText"
                }
              }
            }
          }
        }
      }
    },
    "ui": {
      "const": "ui/index.html",
      "description": "v1 fixed template entry point."
    },
    "trust": {
      "enum": [
        "sandboxed",
        "trusted"
      ],
      "description": "web only: sandboxed bridge or trusted full Node."
    }
  },
  "$defs": {
    "settingText": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        }
      ]
    },
    "strings": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}
