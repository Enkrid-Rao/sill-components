{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sill.local/schemas/layout.schema.json",
  "title": "Sill declarative layout",
  "description": "ui/layout.json for type=declarative. v1 is read-only: no local state, no input, no per-row actions.",
  "$ref": "#/$defs/layoutNode",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:).+$",
      "maxLength": 200
    },
    "bind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Expression over manifest data ids, settings.*, and item.* inside a list template."
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9])?$", "maxLength": 80 },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "align": { "enum": ["start", "center", "end", "stretch"] },
    "justify": { "enum": ["start", "center", "end", "between"] },
    "style": { "enum": ["display", "title", "body", "caption", "mono", "bar", "glass"] },
    "tone": { "enum": ["accent", "warm", "neutral"] },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "action" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$", "maxLength": 60 },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "layoutNode": {
      "oneOf": [
        { "$ref": "#/$defs/vstack" },
        { "$ref": "#/$defs/hstack" },
        { "$ref": "#/$defs/overlay" },
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/bar" },
        { "$ref": "#/$defs/ring" },
        { "$ref": "#/$defs/divider" },
        { "$ref": "#/$defs/spacer" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/button" }
      ]
    },
    "contentNode": {
      "oneOf": [
        { "$ref": "#/$defs/vstack" },
        { "$ref": "#/$defs/hstack" },
        { "$ref": "#/$defs/overlay" },
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/bar" },
        { "$ref": "#/$defs/ring" },
        { "$ref": "#/$defs/divider" },
        { "$ref": "#/$defs/spacer" }
      ]
    },
    "vstack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "vstack" },
        "gap": { "type": "integer", "minimum": 0, "maximum": 24 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 24 },
        "align": { "$ref": "#/$defs/align" },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/layoutNode" }
        }
      }
    },
    "hstack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "hstack" },
        "gap": { "type": "integer", "minimum": 0, "maximum": 24 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 24 },
        "align": { "$ref": "#/$defs/align" },
        "justify": { "$ref": "#/$defs/justify" },
        "wrap": { "type": "boolean" },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/layoutNode" }
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "overlay" },
        "align": { "enum": ["start", "center", "end"] },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/layoutNode" }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "text" },
        "bind": { "$ref": "#/$defs/bind" },
        "value": { "type": "string", "maxLength": 200 },
        "i18n": { "$ref": "#/$defs/i18n" },
        "style": { "$ref": "#/$defs/style" },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 4 },
        "align": { "enum": ["start", "center", "end"] }
      },
      "oneOf": [
        { "required": ["bind"] },
        { "required": ["value"] },
        { "required": ["i18n"] }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "image" },
        "src": { "$ref": "#/$defs/path" },
        "bind": { "$ref": "#/$defs/bind" },
        "map": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": { "$ref": "#/$defs/path" }
        },
        "fallback": { "$ref": "#/$defs/path" },
        "fit": { "enum": ["cover", "contain"] },
        "alt": { "type": "string", "maxLength": 80 },
        "altI18n": { "$ref": "#/$defs/i18n" }
      },
      "oneOf": [
        { "required": ["src"] },
        { "required": ["bind", "map"] }
      ]
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bind"],
      "properties": {
        "type": { "const": "bar" },
        "bind": { "$ref": "#/$defs/bind" },
        "min": { "type": "number" },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "minimum": 2, "maximum": 16 },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bind"],
      "properties": {
        "type": { "const": "ring" },
        "bind": { "$ref": "#/$defs/bind" },
        "min": { "type": "number" },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "size": { "type": "integer", "minimum": 32, "maximum": 120 },
        "thickness": { "type": "integer", "minimum": 3, "maximum": 16 },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "divider" },
        "inset": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "spacer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "spacer" },
        "size": { "type": "integer", "minimum": 0, "maximum": 24 },
        "grow": { "type": "boolean" }
      },
      "oneOf": [{ "required": ["size"] }, { "required": ["grow"] }]
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items", "itemTemplate"],
      "properties": {
        "type": { "const": "list" },
        "items": { "$ref": "#/$defs/bind" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "itemTemplate": { "$ref": "#/$defs/contentNode" },
        "empty": { "$ref": "#/$defs/contentNode" }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action"],
      "properties": {
        "type": { "const": "button" },
        "label": { "type": "string", "maxLength": 40 },
        "i18n": { "$ref": "#/$defs/i18n" },
        "icon": { "$ref": "#/$defs/path" },
        "ariaLabel": { "type": "string", "maxLength": 80 },
        "ariaI18n": { "$ref": "#/$defs/i18n" },
        "variant": { "enum": ["primary", "ghost", "danger"] },
        "disabled": { "$ref": "#/$defs/bind" },
        "action": { "$ref": "#/$defs/action" }
      },
      "allOf": [
        {
          "if": {
            "required": ["icon"],
            "not": {
              "anyOf": [
                { "required": ["label"] },
                { "required": ["i18n"] }
              ]
            }
          },
          "then": {
            "oneOf": [
              { "required": ["ariaLabel"] },
              { "required": ["ariaI18n"] }
            ]
          }
        },
        {
          "if": { "required": ["label"] },
          "then": { "not": { "required": ["i18n"] } }
        }
      ],
      "anyOf": [
        { "required": ["label"] },
        { "required": ["i18n"] },
        { "required": ["icon"] }
      ]
    }
  }
}
